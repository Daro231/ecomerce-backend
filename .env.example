# ==============================================================================
# Spring Boot Environment Variables (.env.example)
# Copy to .env for local testing or configure these in the Railway dashboard.
# NEVER commit real secrets or production passwords into version control.
# ==============================================================================

# Spring Profile (Required: set to 'prod' in Railway)
SPRING_PROFILES_ACTIVE=prod

# Server Port (Railway automatically sets PORT; defaults to 8080)
PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# Railway PostgreSQL plugin automatically provides PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
# ------------------------------------------------------------------------------
PGHOST=
PGPORT=5432
PGDATABASE=railway
PGUSER=postgres
PGPASSWORD=

# Optional: Full JDBC URL (if setting manually instead of using PG* variables)
# Format: jdbc:postgresql://<host>:<port>/<dbname>
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Security & JWT (Required in production)
# Generate a secure 256-bit (32+ chars) random string for production
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-random-256-bit-jwt-secret-here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# CORS (Frontend Integration)
# Comma-separated list of allowed frontend origins (no wildcards in production)
# Example: https://ecom-frontend.up.railway.app,https://myshop.com
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-frontend.up.railway.app

# ------------------------------------------------------------------------------
# Upload Directory (Defaults to /app/uploads in Docker container)
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# Payment / KHQR Settings (mock | bakong)
# ------------------------------------------------------------------------------
KHQR_MODE=mock
KHQR_EXPIRY_MINUTES=10
KHQR_AUTO_CANCEL_MINUTES=30
KHQR_LATE_PAYMENT_WATCH_HOURS=24

# ------------------------------------------------------------------------------
# Bakong API (Required only if KHQR_MODE=bakong)
# ------------------------------------------------------------------------------
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=your_account@bank
BAKONG_MERCHANT_NAME=ECOM Computer Store
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD
BAKONG_KHR_PER_USD=4100
