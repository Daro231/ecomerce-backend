# ==============================================================================
# Spring Boot Backend Environment Variables (.env.example)
# ==============================================================================

# App
# required
SPRING_PROFILES_ACTIVE=prod
# optional (default: 8080)
PORT=8080
# optional (default: /app/uploads)
UPLOAD_DIR=/app/uploads

# Database
# optional (Railway PostgreSQL plugin automatically provides DATABASE_URL or PG* variables)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
# optional (default: localhost)
PGHOST=localhost
# optional (default: 5432)
PGPORT=5432
# optional (default: railway)
PGDATABASE=railway
# optional (default: postgres)
PGUSER=postgres
# optional (default: empty)
PGPASSWORD=your-postgres-password
# optional (default: jdbc:postgresql://${PGHOST:localhost}:${PGPORT:5432}/${PGDATABASE:railway})
DB_URL=jdbc:postgresql://localhost:5432/railway
# optional (default: postgres)
DB_USERNAME=postgres
# optional (default: empty)
DB_PASSWORD=your-db-password

# Security
# required (min 32 characters for HMAC-SHA256)
JWT_SECRET=change-me-min-32-chars-hex-or-base64
# optional (default: 86400000)
JWT_EXPIRATION_MS=86400000

# CORS
# optional (default: empty; set to frontend URL for browser CORS requests, comma-separated for multiple origins)
FRONTEND_URL=https://your-frontend.up.railway.app

# Payment (mock | bakong)
# optional (default: mock)
KHQR_MODE=mock
# optional (default: 10)
KHQR_EXPIRY_MINUTES=10
# optional (default: 5000)
KHQR_POLL_INTERVAL_MS=5000
# optional (default: 5)
KHQR_EXPIRY_GRACE_MINUTES=5
# optional (default: 3)
KHQR_MIN_CHECK_INTERVAL_SECONDS=3
# optional (default: 30)
KHQR_AUTO_CANCEL_MINUTES=30
# optional (default: 60000)
KHQR_AUTO_CANCEL_CHECK_INTERVAL_MS=60000
# optional (default: 24)
KHQR_LATE_PAYMENT_WATCH_HOURS=24
# optional (default: 60000)
KHQR_LATE_PAYMENT_CHECK_INTERVAL_MS=60000

# Bakong API (required only when KHQR_MODE=bakong)
# optional (default: https://api-bakong.nbc.gov.kh)
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
# optional (required if KHQR_MODE=bakong)
BAKONG_TOKEN=your-bakong-api-token
# optional (required if KHQR_MODE=bakong)
BAKONG_ACCOUNT_ID=merchant@bank
# optional (default: ECOM Computer Store)
BAKONG_MERCHANT_NAME=ECOM Computer Store
# optional (default: Phnom Penh)
BAKONG_MERCHANT_CITY=Phnom Penh
# optional (default: USD)
BAKONG_CURRENCY=USD
# optional (default: 4100)
BAKONG_KHR_PER_USD=4100
# optional (default: ECOM)
BAKONG_STORE_LABEL=ECOM
# optional (default: WEB)
BAKONG_TERMINAL_LABEL=WEB
